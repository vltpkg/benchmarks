# Base URL of the served benchmark data tree (@benchmarks/data).
#
# NEXT_PUBLIC_DATA_URL is read at BUILD time. Next constant-folds every
# NEXT_PUBLIC_* read into the bundle, so changing this value requires a
# rebuild -- `next start` will not pick it up.
#
# Local development, after `vlt run --workspace=apps/data build`:
#   vlt run --workspace=apps/data start   # serves results/ on :8811
#
# Production is the gh-pages origin (its CNAME), which serves the same tree.
# Not benchmarks.vlt.sh: that is the site, and it answers HTML for any path.
#   NEXT_PUBLIC_DATA_URL=https://benchmarks-data.vlt.io
NEXT_PUBLIC_DATA_URL=http://localhost:8811

# Optional server-side runtime override, checked first when set.
#
# Every fetch in this app happens on the server, so this one is NOT inlined and
# does repoint an already-built app at another origin. Useful for pointing a
# single build at a staging tree, and for verifying the endpoint is switchable
# without rebuilding. Leave it unset for normal use.
#
#   DATA_URL=http://localhost:8899
